# Ablation config: farquhar_jarvis model, photoperiod=12h
# Base config: config/default.config
#
# Per-photoperiod parameters (Table A.1 of the manuscript):
#   lambda_c   (feedback_on_photosynthesis) = 1.0000  [fixed]
#   lambda_sni (night starch partition)     = 0.1200  [fixed]
#   lambda_sb  (growth rate)                = 0.00342407  [calibrated: RGR=0.2600]
#   lambda_sdi (starch synthesis rate)     = 0.18229370  [calibrated: EOD starch=58.73]
#
# Reproduce: ./build/ablation_runner --days 30 --config config/default.config

simulation.days = 30
simulation.gui_enabled = false
simulation.write_csv = false

input.photo.photoperiod = 12
input.photo.feedback_on_photosynthesis = 1.000000
input.carbohydrates.lambda_sni = 0.120000
input.growth.lambda_sb = 0.00342407
input.carbohydrates.lambda_sdi = 0.18229370
