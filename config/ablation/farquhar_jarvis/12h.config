# Ablation config: farquhar_jarvis model, photoperiod=12h
# Base config: config/default.config
#
# Per-photoperiod parameters (Table A.1, Annunziata et al.):
#   lambda_c   (feedback_on_photosynthesis) = 0.6200  [fixed, not calibrated]
#   lambda_sni (night starch partition)     = 0.0800  [fixed, not calibrated]
#   lambda_sb  (growth rate)                = 0.00585014  [calibrated to match lit RGR=0.2600]
#
# Reproduce: ./build/ablation_runner --days 30 --config config/default.config

simulation.days = 30
simulation.gui_enabled = false
simulation.write_csv = false

input.photo.photoperiod = 12
input.photo.feedback_on_photosynthesis = 0.620000
input.carbohydrates.lambda_sni = 0.080000
input.growth.lambda_sb = 0.00585014
