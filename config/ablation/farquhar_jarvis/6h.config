# Ablation config: farquhar_jarvis model, photoperiod=6h
# Base config: config/default.config
#
# Per-photoperiod parameters (Table A.1, Annunziata et al.):
#   lambda_c   (feedback_on_photosynthesis) = 0.7900  [fixed]
#   lambda_sni (night starch partition)     = 0.1500  [fixed]
#   lambda_sb  (growth rate)                = 0.00448566  [calibrated: RGR=0.1135]
#   lambda_sdi (starch synthesis rate)     = 0.30000000  [calibrated: EOD starch=54.24]
#
# Reproduce: ./build/ablation_runner --days 30 --config config/default.config

simulation.days = 30
simulation.gui_enabled = false
simulation.write_csv = false

input.photo.photoperiod = 6
input.photo.feedback_on_photosynthesis = 0.790000
input.carbohydrates.lambda_sni = 0.150000
input.growth.lambda_sb = 0.00448566
input.carbohydrates.lambda_sdi = 0.30000000
