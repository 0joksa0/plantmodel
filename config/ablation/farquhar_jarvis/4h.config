# Ablation config: farquhar_jarvis model, photoperiod=4h
# Base config: config/default.config
#
# Per-photoperiod parameters (Table A.1, Annunziata et al.):
#   lambda_c   (feedback_on_photosynthesis) = 0.8200  [fixed]
#   lambda_sni (night starch partition)     = 0.1600  [fixed]
#   lambda_sb  (growth rate)                = 0.00384188  [calibrated: RGR=0.0680]
#   lambda_sdi (starch synthesis rate)     = 0.05000000  [calibrated: EOD starch=29.67]
#
# Reproduce: ./build/ablation_runner --days 30 --config config/default.config

simulation.days = 30
simulation.gui_enabled = false
simulation.write_csv = false

input.photo.photoperiod = 4
input.photo.feedback_on_photosynthesis = 0.820000
input.carbohydrates.lambda_sni = 0.160000
input.growth.lambda_sb = 0.00384188
input.carbohydrates.lambda_sdi = 0.05000000
