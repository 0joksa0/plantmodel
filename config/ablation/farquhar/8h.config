# Ablation config: farquhar model, photoperiod=8h
# Base config: config/default.config
#
# Per-photoperiod parameters (Table A.1, Annunziata et al.):
#   lambda_c   (feedback_on_photosynthesis) = 0.6700  [fixed]
#   lambda_sni (night starch partition)     = 0.1300  [fixed]
#   lambda_sb  (growth rate)                = 0.00564802  [calibrated: RGR=0.1708]
#
# Reproduce: ./build/ablation_runner --days 30 --config config/default.config

simulation.days = 30
simulation.gui_enabled = false
simulation.write_csv = false

input.photo.photoperiod = 8
input.photo.feedback_on_photosynthesis = 0.670000
input.carbohydrates.lambda_sni = 0.130000
input.growth.lambda_sb = 0.00564802
