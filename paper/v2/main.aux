\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Model parameters, generated from the provenance ledger of the released repository. Values are those loaded by the shipped configuration, or the literal in the source where a parameter is not exposed in the configuration file. Tiers: T1 measured, T2 derived, T3 inherited from the source model, T4 constrained, T5 fitted, T6 unsourced, n/l not entered in the ledger. The four parameters calibrated in this work are given separately in Table\nobreakspace  {}\ref  {tab:fitted}. \textsuperscript  {a}Source key present in the ledger but not yet in the reference list of this paper. \textsuperscript  {b}Literal in the source, not exposed as a configuration key. See the TODO items in Section\nobreakspace  {}\ref  {sec:params}.}}{34}{table.3}\protected@file@percent }
\newlabel{tab:params}{{3}{34}{Model parameters, generated from the provenance ledger of the released repository. Values are those loaded by the shipped configuration, or the literal in the source where a parameter is not exposed in the configuration file. Tiers: T1 measured, T2 derived, T3 inherited from the source model, T4 constrained, T5 fitted, T6 unsourced, n/l not entered in the ledger. The four parameters calibrated in this work are given separately in Table~\ref {tab:fitted}. \textsuperscript {a}Source key present in the ledger but not yet in the reference list of this paper. \textsuperscript {b}Literal in the source, not exposed as a configuration key. See the TODO items in Section~\ref {sec:params}}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces The four parameters calibrated in this work. All four are shared: one value of each is used at every photoperiod in every reported run. All are tier T5 by the classification of Section\nobreakspace  {}\ref  {sec:params}. The published baseline calibrated eight parameters per photoperiod against the same eight observations.}}{35}{table.4}\protected@file@percent }
\newlabel{tab:fitted}{{4}{35}{The four parameters calibrated in this work. All four are shared: one value of each is used at every photoperiod in every reported run. All are tier T5 by the classification of Section~\ref {sec:params}. The published baseline calibrated eight parameters per photoperiod against the same eight observations}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Parameterisation regimes. All three use the same chamber forcing (PAR 160\nobreakspace  {}$\mu $mol\nobreakspace  {}m$^{-2}$\nobreakspace  {}s$^{-1}$, square wave, 21/19\nobreakspace  {}$^\circ $C), the same initial state and the same sourced parameters. $P$ denotes photoperiod in hours. The observation count is two per photoperiod, the published RGR and the published end-of-day starch. Regime R1 is reported as a calibration diagnostic; only R2 and R3 enter the cross-validation of Section\nobreakspace  {}\ref  {sec:crossval_design}.}}{35}{table.5}\protected@file@percent }
\newlabel{tab:scenarios}{{5}{35}{Parameterisation regimes. All three use the same chamber forcing (PAR 160~$\mu $mol~m$^{-2}$~s$^{-1}$, square wave, 21/19~$^\circ $C), the same initial state and the same sourced parameters. $P$ denotes photoperiod in hours. The observation count is two per photoperiod, the published RGR and the published end-of-day starch. Regime R1 is reported as a calibration diagnostic; only R2 and R3 enter the cross-validation of Section~\ref {sec:crossval_design}}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Relative growth rate under the shared parameterisation, chamber forcing, 30 days. Targets are the \textit  {Arabidopsis thaliana} rosette values of \citet  {Sulpice2014}. The last column gives the per-photoperiod residual of the saturated per-photoperiod calibration on the grid described in Section\nobreakspace  {}\ref  {sec:results:rgr}; those residuals are set by the grid resolution and are reported as calibration diagnostics, not as errors of prediction.}}{35}{table.6}\protected@file@percent }
\newlabel{tab:rgr}{{6}{35}{Relative growth rate under the shared parameterisation, chamber forcing, 30 days. Targets are the \textit {Arabidopsis thaliana} rosette values of \citet {Sulpice2014}. The last column gives the per-photoperiod residual of the saturated per-photoperiod calibration on the grid described in Section~\ref {sec:results:rgr}; those residuals are set by the grid resolution and are reported as calibration diagnostics, not as errors of prediction}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Leave-one-photoperiod-out prediction of relative growth rate. In regime A the growth coefficient is a single shared constant; in regime B it is linear in photoperiod with two coefficients (Eq.\nobreakspace  {}\ref  {eq:lsb_linear}). Train error is the mean over the three fitted photoperiods; test error is the held-out photoperiod. The $\lambda _{sb}$ column gives the value applied at the held-out photoperiod.}}{36}{table.7}\protected@file@percent }
\newlabel{tab:crossval}{{7}{36}{Leave-one-photoperiod-out prediction of relative growth rate. In regime A the growth coefficient is a single shared constant; in regime B it is linear in photoperiod with two coefficients (Eq.~\ref {eq:lsb_linear}). Train error is the mean over the three fitted photoperiods; test error is the held-out photoperiod. The $\lambda _{sb}$ column gives the value applied at the held-out photoperiod}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Ablation of the carbon-input pathway. M0 prescribes the carbon input, M1 computes it from Farquhar photosynthesis at fixed conductance, and M2 adds Jarvis stomatal conductance. Shared parameters are frozen across the three variants. Errors are relative errors in RGR; the last column is the peak assimilation rate.}}{36}{table.8}\protected@file@percent }
\newlabel{tab:ablation}{{8}{36}{Ablation of the carbon-input pathway. M0 prescribes the carbon input, M1 computes it from Farquhar photosynthesis at fixed conductance, and M2 adds Jarvis stomatal conductance. Shared parameters are frozen across the three variants. Errors are relative errors in RGR; the last column is the peak assimilation rate}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Global sensitivity of relative growth rate, averaged over the four photoperiods. $S_1$ is the first-order and $S_T$ the total-order Sobol' index; the interaction remainder is $S_T - S_1$. $\mu ^{*}$ and $\sigma $ are the Morris measures. Indices are reported unclipped, so a remainder at noise level can be slightly negative. Ranges and sampling scales are in Appendix\nobreakspace  {}\ref  {app:sa}; the indices are conditional on those ranges.}}{36}{table.9}\protected@file@percent }
\newlabel{tab:sens}{{9}{36}{Global sensitivity of relative growth rate, averaged over the four photoperiods. $S_1$ is the first-order and $S_T$ the total-order Sobol' index; the interaction remainder is $S_T - S_1$. $\mu ^{*}$ and $\sigma $ are the Morris measures. Indices are reported unclipped, so a remainder at noise level can be slightly negative. Ranges and sampling scales are in Appendix~\ref {app:sa}; the indices are conditional on those ranges}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Complete parameter provenance ledger, generated from \texttt  {config/parameter\_provenance.csv}. Locator gives the equation, section or source line from which the value comes; a dash means no locator is recorded.}}{37}{table.10}\protected@file@percent }
\newlabel{tab:provenance}{{10}{37}{Complete parameter provenance ledger, generated from \texttt {config/parameter\_provenance.csv}. Locator gives the equation, section or source line from which the value comes; a dash means no locator is recorded}{table.10}{}}
