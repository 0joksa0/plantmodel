\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Net daily starch gain against photoperiod on a symmetric-log axis, under the chamber forcing and under the shipped half-sine profile at $1200\nobreakspace  {}\mu \mathrm  {mol}$ m$^{-2}$ s$^{-1}$. The band marks the closure boundary at $15.0$--$15.5$\nobreakspace  {}h under chamber forcing. Under the higher dose the balance does not close at any photoperiod shown, so the boundary depends on the light dose as well as on the model.}}{28}{figure.7}\protected@file@percent }
\newlabel{fig:envelope}{{7}{28}{Net daily starch gain against photoperiod on a symmetric-log axis, under the chamber forcing and under the shipped half-sine profile at $1200~\mu \mathrm {mol}$ m$^{-2}$ s$^{-1}$. The band marks the closure boundary at $15.0$--$15.5$~h under chamber forcing. Under the higher dose the balance does not close at any photoperiod shown, so the boundary depends on the light dose as well as on the model}{figure.7}{}}
