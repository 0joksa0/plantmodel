\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Model parameters, generated from the provenance ledger of the released repository. Values are those loaded by the shipped configuration, or the literal in the source where a parameter is not exposed in the configuration file. Tiers: T1 measured, T2 derived, T3 inherited from the source model, T4 constrained, T5 fitted, T6 unsourced. The four parameters calibrated in this work are given separately in Table\nobreakspace  {}\ref  {tab:fitted}. \textsuperscript  {a}Literal in the source, not exposed as a configuration key; its ledger row records the same provenance fields as a configuration parameter.}}{36}{table.2}\protected@file@percent }
\newlabel{tab:params}{{2}{36}{Model parameters, generated from the provenance ledger of the released repository. Values are those loaded by the shipped configuration, or the literal in the source where a parameter is not exposed in the configuration file. Tiers: T1 measured, T2 derived, T3 inherited from the source model, T4 constrained, T5 fitted, T6 unsourced. The four parameters calibrated in this work are given separately in Table~\ref {tab:fitted}. \textsuperscript {a}Literal in the source, not exposed as a configuration key; its ledger row records the same provenance fields as a configuration parameter}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The four parameters calibrated in this work. All four are shared: one value of each is used at every photoperiod in every reported run. All are tier T5 by the classification of Section\nobreakspace  {}\ref  {sec:params}. The published baseline calibrated eight parameters per photoperiod against the same eight observations. The ledger of Appendix\nobreakspace  {}\ref  {app:params} marks 15 entries as tier T5. That tier records that a value was obtained by fitting at some point in the model's history, including values inherited already fitted from the source model; the four listed here are the ones calibrated in this work, and the remaining T5 entries were not adjusted for any result reported in this paper.}}{37}{table.3}\protected@file@percent }
\newlabel{tab:fitted}{{3}{37}{The four parameters calibrated in this work. All four are shared: one value of each is used at every photoperiod in every reported run. All are tier T5 by the classification of Section~\ref {sec:params}. The published baseline calibrated eight parameters per photoperiod against the same eight observations. The ledger of Appendix~\ref {app:params} marks 15 entries as tier T5. That tier records that a value was obtained by fitting at some point in the model's history, including values inherited already fitted from the source model; the four listed here are the ones calibrated in this work, and the remaining T5 entries were not adjusted for any result reported in this paper}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Parameterisation regimes. All three use the same chamber forcing (PAR 160\nobreakspace  {}$\mu $mol\nobreakspace  {}m$^{-2}$\nobreakspace  {}s$^{-1}$, square wave, 21/19\nobreakspace  {}$^\circ $C), the same initial state and the same sourced parameters. $P$ denotes photoperiod in hours. The observation count is two per photoperiod, the published RGR and the published end-of-day starch. Regime R1 is reported as a calibration diagnostic; only R2 and R3 enter the cross-validation of Section\nobreakspace  {}\ref  {sec:crossval_design}.}}{37}{table.4}\protected@file@percent }
\newlabel{tab:scenarios}{{4}{37}{Parameterisation regimes. All three use the same chamber forcing (PAR 160~$\mu $mol~m$^{-2}$~s$^{-1}$, square wave, 21/19~$^\circ $C), the same initial state and the same sourced parameters. $P$ denotes photoperiod in hours. The observation count is two per photoperiod, the published RGR and the published end-of-day starch. Regime R1 is reported as a calibration diagnostic; only R2 and R3 enter the cross-validation of Section~\ref {sec:crossval_design}}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Relative growth rate under the shared parameterisation, chamber forcing, 30 days. Targets are the \textit  {Arabidopsis thaliana} rosette values of \citet  {Sulpice2014}. The last column gives the per-photoperiod residual of the saturated per-photoperiod calibration on the grid described in Section\nobreakspace  {}\ref  {sec:results:rgr}; those residuals are set by the grid resolution and are reported as calibration diagnostics, not as errors of prediction.}}{37}{table.5}\protected@file@percent }
\newlabel{tab:rgr}{{5}{37}{Relative growth rate under the shared parameterisation, chamber forcing, 30 days. Targets are the \textit {Arabidopsis thaliana} rosette values of \citet {Sulpice2014}. The last column gives the per-photoperiod residual of the saturated per-photoperiod calibration on the grid described in Section~\ref {sec:results:rgr}; those residuals are set by the grid resolution and are reported as calibration diagnostics, not as errors of prediction}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Leave-one-photoperiod-out prediction of relative growth rate. In regime A the growth coefficient is a single shared constant; in regime B it is linear in photoperiod with two coefficients (Eq.\nobreakspace  {}\ref  {eq:lsb_linear}). Train error is the mean over the three fitted photoperiods; test error is the held-out photoperiod. The $\lambda _{sb}$ column gives the value applied at the held-out photoperiod.}}{38}{table.6}\protected@file@percent }
\newlabel{tab:crossval}{{6}{38}{Leave-one-photoperiod-out prediction of relative growth rate. In regime A the growth coefficient is a single shared constant; in regime B it is linear in photoperiod with two coefficients (Eq.~\ref {eq:lsb_linear}). Train error is the mean over the three fitted photoperiods; test error is the held-out photoperiod. The $\lambda _{sb}$ column gives the value applied at the held-out photoperiod}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Ablation of the carbon-input pathway. M0 prescribes the carbon input, M1 computes it from Farquhar photosynthesis at fixed conductance, and M2 adds Jarvis stomatal conductance. Shared parameters are frozen across the three variants. Errors are relative errors in RGR; the last column is the peak assimilation rate.}}{38}{table.7}\protected@file@percent }
\newlabel{tab:ablation}{{7}{38}{Ablation of the carbon-input pathway. M0 prescribes the carbon input, M1 computes it from Farquhar photosynthesis at fixed conductance, and M2 adds Jarvis stomatal conductance. Shared parameters are frozen across the three variants. Errors are relative errors in RGR; the last column is the peak assimilation rate}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Global sensitivity of relative growth rate, averaged over the four photoperiods. $S_1$ is the first-order and $S_T$ the total-order Sobol' index; the interaction remainder is $S_T - S_1$. $\mu ^{*}$ and $\sigma $ are the Morris measures. Indices are reported unclipped, so a remainder at noise level can be slightly negative. Ranges and sampling scales are in Appendix\nobreakspace  {}\ref  {app:sa}; the indices are conditional on those ranges.}}{38}{table.8}\protected@file@percent }
\newlabel{tab:sens}{{8}{38}{Global sensitivity of relative growth rate, averaged over the four photoperiods. $S_1$ is the first-order and $S_T$ the total-order Sobol' index; the interaction remainder is $S_T - S_1$. $\mu ^{*}$ and $\sigma $ are the Morris measures. Indices are reported unclipped, so a remainder at noise level can be slightly negative. Ranges and sampling scales are in Appendix~\ref {app:sa}; the indices are conditional on those ranges}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Complete parameter provenance ledger, generated from \texttt  {config/parameter\_provenance.csv}. Locator gives the equation, section or source line from which the value comes; a dash means no locator is recorded.}}{39}{table.9}\protected@file@percent }
\newlabel{tab:provenance}{{9}{39}{Complete parameter provenance ledger, generated from \texttt {config/parameter\_provenance.csv}. Locator gives the equation, section or source line from which the value comes; a dash means no locator is recorded}{table.9}{}}
